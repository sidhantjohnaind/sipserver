# Auto-detect text files and normalize line endings
* text=auto

# Force LF for shell scripts (must have LF on Linux)
*.sh text eol=lf
*.service text eol=lf
Makefile text eol=lf

# Force CRLF for Windows-only files
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files — no line ending conversion
*.exe binary
*.o binary
*.obj binary
*.a binary
*.lib binary

# GitHub Linguist Overrides — mark build scripts, tools & sniffer scripts as vendored so C++ is the primary repository language
*.py linguist-vendored
scripts/** linguist-vendored

