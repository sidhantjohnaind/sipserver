# Copy this file to .env and fill in your real values
# Run: python create_env_jfibersip.py  ← auto-fills everything from your Jio router

CONTAINER_NAME=jfc-pjsua
HOSTNAME_OVERRIDE=JioWinPC
UUID=00000000-0000-1000-8000-000000000000
USER_AGENT=JSEAndrd-1.0

# Network
IPV4_ADDRESS=192.168.1.100
LOCAL_PORT=5061
TLS_PORT=5068
RTP_PORT=52000

# Jio IMS credentials (filled automatically by create_env_jfibersip.py)
PUBLIC_ID=sip:+91XXXXXXXXXX@br.wln.ims.jio.com
SIP_AUTH_USER=91XXXXXXXXXX@br.wln.ims.jio.com
SIP_PASSWORD=your_sip_password_here
SIP_REALM=br.wln.ims.jio.com

# Jio router / ONT
REGISTRAR_HOST=192.168.1.1
REGISTRAR_PORT=5068
PROXY_HOST=192.168.1.1
PROXY_PORT=5068
DNS_SERVERS=192.168.1.1

# Options
LOG_LEVEL=5
KEEPALIVE=15
MAX_CALLS=4
TLS_VERIFY=0
